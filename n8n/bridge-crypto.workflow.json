      "id": "bridge-05",
      "name": "Ambil Quote LI.FI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "url": "https://li.quest/v1/quote",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fromChain",
              "value": "={{ $json.fromChain }}"
            },
            {
              "name": "toChain",
