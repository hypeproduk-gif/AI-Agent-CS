      "onError": "continueRegularOutput",
      "id": "aics-setup-2"
    },
    {
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      },
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "name": "Daftar Store",
      "id": "aics-setup-3"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.scalev.com/v3/stores/{{ $json.id }}/products?page_size=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 20000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        660,
        0
      ],
      "name": "Ambil Produk",
      "onError": "continueRegularOutput",
      "id": "aics-setup-4"
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nconst stores = $('Daftar Store').all();\nfor (const [i, item] of $input.all().entries()) {\n  const store = (stores[i] || stores[0]).json;\n  for (const p of item.json.data || []) {\n    const variants = p.variants || p.product_variants || p.variant_list || [];\n    const base = {\n      store_id: store.id, store_unique_id: store.unique_id, store_name: store.name,\n      product_id: p.id, product: p.name,\n    };\n    if (!variants.length) {\n      out.push({ json: { ...base, catatan: 'varian tidak ditemukan', field_produk: Object.keys(p).join(', ') } });\n    }\n    for (const v of variants) {\n      out.push({ json: { ...base, variant: v.fullname || v.name, variant_id: v.id,\n        variant_unique_id: v.unique_id || v.uuid, price: v.price } });\n    }\n  }\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "name": "Ringkas ID",
      "id": "aics-setup-5"
    }
  ],
