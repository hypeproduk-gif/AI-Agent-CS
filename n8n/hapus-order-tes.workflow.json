      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "name": "Daftar Order",
      "id": "aics-clean-2"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.scalev.com/v3/orders?search={{ $json.order_id }}&page_size=5",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 20000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        440,
        0
      ],
      "name": "Cari Order",
      "onError": "continueRegularOutput",
      "id": "aics-clean-3",
      "credentials": {
        "httpHeaderAuth": {
          "id": "3nbV3AIwVIWymgsu",
          "name": "Scalev"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const wanted = $('Daftar Order').all().map((i) => i.json.order_id);\nconst ids = [];\nconst found = [];\nfor (const item of $input.all()) {\n  const list = (item.json && (item.json.data && (item.json.data.results || item.json.data))) || [];\n  for (const o of Array.isArray(list) ? list : []) {\n    if (wanted.includes(o.order_id) && !ids.includes(o.id)) { ids.push(o.id); found.push(o.order_id); }\n  }\n}\nreturn [{ json: { ids, found, missing: wanted.filter((w) => !found.includes(w)) } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "name": "Ambil ID",
      "id": "aics-clean-4"
    },
