    {
      "parameters": {
        "jsCode": "// Order ID Scalev (bukan UUID) yang mau dibatalkan lalu dihapus.\nconst ORDER_IDS = [\"260927GXFGSJS\",\"260927ZAEKENZ\",\"260927LWLMRCX\",\"260927CECGRKR\"];\nreturn ORDER_IDS.map((order_id) => ({ json: { order_id } }));"
      },
