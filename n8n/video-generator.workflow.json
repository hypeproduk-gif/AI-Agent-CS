{
  "name": "Video Generator (Gambar + Cerita → Video)",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Buat Video dari Gambar",
        "formDescription": "Upload keyframe (urut shot 1, 2, ...) dan alur cerita. Video dikirim ke Telegram ± 5–15 menit.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Gambar",
              "fieldType": "file",
              "multipleFiles": true,
              "acceptFileTypes": ".jpg, .jpeg, .png, .webp",
              "requiredField": true
            },
            {
              "fieldLabel": "Cerita",
              "fieldType": "textarea",
              "placeholder": "0-4 detik: ...\n4-8 detik: ...",
              "requiredField": true
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Diterima! Video sedang dibuat, hasilnya dikirim ke Telegram."
            }
          }
        }
      },
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "name": "Form Video",
      "webhookId": "video-gen-form",
      "id": "video-gen-1"
    },
    {
      "parameters": {
        "jsCode": "// Ambil gambar (urut upload) + cerita -> request Claude untuk menulis gerakan tiap shot.\nconst item = $input.first();\nconst keys = Object.keys(item.binary || {}).sort((a, b) => Number(a.split('_').pop()) - Number(b.split('_').pop()));\nif (!keys.length) throw new Error('Tidak ada gambar.');\nconst images = [];\nfor (const k of keys) {\n  const buf = await this.helpers.getBinaryDataBuffer(0, k);\n  images.push({ mime: item.binary[k].mimeType || 'image/png', b64: buf.toString('base64') });\n}\nconst cerita = item.json['Cerita'];\nconst system = `Kamu sutradara iklan video pendek. Setiap gambar = keyframe awal 1 shot, sesuai urutan.\nTulis gerakan untuk tiap shot mengikuti alur cerita. Balas HANYA JSON:\n{\"style\":\"<gaya visual singkat, Inggris>\",\"shots\":[{\"prompt\":\"<gerakan kamera & subjek, Inggris, spesifik, realistis, 1 aksi>\",\"duration\":\"5\"}]}\nJumlah shots HARUS sama dengan jumlah gambar (${images.length}). duration \"5\" atau \"10\" (pilih yang paling dekat dengan durasi di cerita).\nJangan tambah orang/benda yang tidak ada di gambar. Tanpa orang berbicara.`;\nconst content = [];\nimages.forEach((im, i) => {\n  content.push({ type: 'text', text: `Gambar shot ${i + 1}:` });\n  content.push({ type: 'image', source: { type: 'base64', media_type: im.mime, data: im.b64 } });\n});\ncontent.push({ type: 'text', text: `Alur cerita:\\n${cerita}` });\nreturn [{ json: { cerita, images, body: { model: 'claude-sonnet-5-5', max_tokens: 2000, system, messages: [{ role: 'user', content }] } } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "name": "Siapkan Prompt",
      "id": "video-gen-2"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "options": {
          "timeout": 120000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "name": "Claude Storyboard",
      "credentials": {
        "httpHeaderAuth": {
          "id": "Rg3kLQlwRT919UB4",
          "name": "Anthropic API"
        }
      },
      "id": "video-gen-3"
    },
    {
      "parameters": {
        "jsCode": "// 1 item per shot, siap dikirim ke Kling.\nconst prep = $('Siapkan Prompt').first().json;\nconst text = $input.first().json.content[0].text;\nconst plan = JSON.parse(text.slice(text.indexOf('{'), text.lastIndexOf('}') + 1));\nif (plan.shots.length !== prep.images.length) throw new Error(`Claude memberi ${plan.shots.length} shot untuk ${prep.images.length} gambar.`);\nreturn plan.shots.map((s, i) => ({ json: {\n  idx: i,\n  rencana: s.prompt,\n  payload: {\n    prompt: `${s.prompt}. ${plan.style}. Keep everything identical to the first frame, no morphing, no new objects.`,\n    image_url: `data:${prep.images[i].mime};base64,${prep.images[i].b64}`,\n    duration: String(s.duration || '5'),\n    negative_prompt: 'blur, distort, low quality, morphing, extra fingers, text, watermark',\n    cfg_scale: 0.5,\n  },\n} }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "name": "Pecah Shot",
      "id": "video-gen-4"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://queue.fal.run/fal-ai/kling-video/v2.1/pro/image-to-video",
        "options": {
          "timeout": 120000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "name": "Kirim ke Kling",
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "fal.ai"
        }
      },
      "id": "video-gen-5"
    },
    {
      "parameters": {
        "jsCode": "// Gabungkan info job fal dengan shot-nya (urutan item sama).\nconst shots = $('Pecah Shot').all();\nreturn $input.all().map((it, i) => ({ json: {\n  idx: shots[i].json.idx, rencana: shots[i].json.rencana,\n  status_url: it.json.status_url, response_url: it.json.response_url, tries: 0,\n} }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "name": "Simpan Job",
      "id": "video-gen-6"
    },
    {
      "parameters": {
        "amount": 45
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1320,
        0
      ],
      "name": "Tunggu",
      "webhookId": "video-gen-wait",
      "id": "video-gen-7"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.status_url }}",
        "options": {
          "timeout": 120000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        0
      ],
      "name": "Cek Status",
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "fal.ai"
        }
      },
      "id": "video-gen-8"
    },
    {
      "parameters": {
        "jsCode": "// Cek semua job; done=true jika semua selesai.\nconst prev = $('Tunggu').all();\nconst res = $input.all();\nconst jobs = prev.map((p, i) => ({ ...p.json, status: res[i].json.status, tries: p.json.tries + 1 }));\nconst bad = jobs.filter(j => !['IN_QUEUE', 'IN_PROGRESS', 'COMPLETED'].includes(j.status));\nif (bad.length) throw new Error('fal gagal: ' + JSON.stringify(res.map(r => r.json)));\nif (jobs[0].tries > 40) throw new Error('Timeout: video belum selesai setelah ~30 menit.');\nconst done = jobs.every(j => j.status === 'COMPLETED');\nreturn jobs.map(j => ({ json: { ...j, done } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ],
      "name": "Cek Semua",
      "id": "video-gen-9"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.done }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1980,
        0
      ],
      "name": "Semua Selesai?",
      "id": "video-gen-10"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.response_url }}",
        "options": {
          "timeout": 120000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        -100
      ],
      "name": "Ambil Klip",
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "fal.ai"
        }
      },
      "id": "video-gen-11"
    },
    {
      "parameters": {
        "jsCode": "// Urutkan klip sesuai shot.\nconst jobs = $('Cek Semua').all();\nconst urls = $input.all().map((it, i) => ({ idx: jobs[i].json.idx, url: it.json.video.url }))\n  .sort((a, b) => a.idx - b.idx).map(x => x.url);\nconst rencana = jobs.map(j => j.json).sort((a, b) => a.idx - b.idx).map((j, i) => `${i + 1}. ${j.rencana}`).join('\\n');\nreturn [{ json: { video_urls: urls, rencana } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        -100
      ],
      "name": "Urutkan Klip",
      "id": "video-gen-12"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://fal.run/fal-ai/ffmpeg-api/merge-videos",
        "options": {
          "timeout": 120000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ video_urls: $json.video_urls }) }}"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2640,
        -100
      ],
      "name": "Gabung Video",
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "fal.ai"
        }
      },
      "id": "video-gen-13"
    },
    {
      "parameters": {
        "operation": "sendVideo",
        "chatId": "-5439732568",
        "file": "={{ $json.video.url }}",
        "additionalFields": {
          "caption": "={{ '🎬 Video jadi\\n\\n' + $('Urutkan Klip').first().json.rencana }}"
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        2860,
        -100
      ],
      "name": "Kirim ke Telegram",
      "credentials": {
        "telegramApi": {
          "id": "GvWCKSvWULLSOTrP",
          "name": "Telegram account"
        }
      },
      "id": "video-gen-14"
    }
  ],
