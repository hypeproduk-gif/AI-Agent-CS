ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5

# Meta Graph API (token Page jangka panjang dengan izin:
# pages_manage_posts, pages_read_engagement, instagram_basic, instagram_content_publish)
META_PAGE_ID=
META_PAGE_TOKEN=
META_IG_USER_ID=
GRAPH_VERSION=v21.0

# Instagram wajib ambil video dari URL publik.
# Isi folder PUBLIC_DIR yang disajikan di PUBLIC_BASE_URL (mis. VPS nginx / bucket R2).
PUBLIC_DIR=./public
PUBLIC_BASE_URL=https://media.domainanda.com
